# Node environment (development, production, test)
NODE_ENV=development

# API server port
PORT=8080

# Frontend URL (for CORS) - comma-separated for multiple origins
WEB_URL=http://localhost:5173,http://192.168.X.X:5173

# API URL (for SSR requests from web app)
API_URL=http://localhost:8080

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://movies:movies_dev_password@localhost:5432/movies_db

# Session cookie secret (min 32 characters)
COOKIE_SECRET=your_local_dev_secret_change_in_production

# Health Check
HEALTH_MEMORY_THRESHOLD_MB=512
HEALTH_CHECK_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=debug
LOG_HTTP_REQUESTS=true
