{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@repo/typescript-config/nest.json"],
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "$src/*": ["./src/*"],
      "$modules/*": ["./src/modules/*"],
      "$infra/*": ["./src/infra/*"],
      "$shared/*": ["./src/shared/*"],
      "$test/*": ["./test/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
